{% doc %}
  @prompt
    genere une grosse image d'accueil aux dimensions de bas avec deu options de personnalisation : pour ordi et pour tel : 51080X1080)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    position: relative;
  }

  .ai-hero-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .ai-hero-image-desktop-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-hero-image-mobile-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: none;
  }

  .ai-hero-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1080 / 1080;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-hero-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-hero-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-image-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-hero-image-mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-hero-image-placeholder-{{ ai_gen_id }} {
      aspect-ratio: 1080 / 1080;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-hero-image-placeholder-{{ ai_gen_id }} {
      aspect-ratio: 1080 / 1080;
    }
  }
{% endstyle %}

<div class="ai-hero-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image_desktop or block.settings.image_mobile %}
      {% if block.settings.image_desktop %}
        <img
          src="{{ block.settings.image_desktop | image_url: width: 2160 }}"
          alt="{{ block.settings.image_desktop.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_desktop.width }}"
          height="{{ block.settings.image_desktop.height }}"
          class="ai-hero-image-desktop-{{ ai_gen_id }}"
        >
      {% endif %}

      {% if block.settings.image_mobile %}
        <img
          src="{{ block.settings.image_mobile | image_url: width: 1080 }}"
          alt="{{ block.settings.image_mobile.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_mobile.width }}"
          height="{{ block.settings.image_mobile.height }}"
          class="ai-hero-image-mobile-{{ ai_gen_id }}"
        >
      {% endif %}
    {% else %}
      <div class="ai-hero-image-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-hero-empty-state-{{ ai_gen_id }}">
          Ajoutez une image pour ordinateur et mobile
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Image d'accueil",
  "settings": [
    {
      "type": "header",
      "content": "Image pour ordinateur"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image ordinateur"
    },
    {
      "type": "header",
      "content": "Image pour mobile"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image mobile"
    }
  ],
  "presets": [
    {
      "name": "Image d'accueil"
    }
  ]
}
{% endschema %}
