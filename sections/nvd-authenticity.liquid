{%- comment -%}NOVADESTOCK — Authenticité{%- endcomment -%}
{% render 'nvd-css', accent: section.settings.accent_color, ink: section.settings.text_color %}
<style>
#shopify-section-{{ section.id }} .au{background:{{ section.settings.background_color }};padding:{{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px}
#shopify-section-{{ section.id }} .au__g{display:grid;grid-template-columns:.85fr 1.15fr;gap:58px;align-items:center}
#shopify-section-{{ section.id }} .au__seal{border-radius:26px;padding:34px;display:grid;place-items:center;background:linear-gradient(155deg,color-mix(in srgb,var(--a) 13%,#fff),#fff 70%);border:1px solid color-mix(in srgb,var(--a) 18%,transparent)}
#shopify-section-{{ section.id }} .au__seal img{width:100%;height:auto;border-radius:18px}
#shopify-section-{{ section.id }} .au__lead{font-size:16px;line-height:1.62;margin:0 0 28px;color:var(--muted)}
#shopify-section-{{ section.id }} .au__l{display:grid;gap:16px}
#shopify-section-{{ section.id }} .au__r{display:flex;gap:13px;align-items:flex-start}
#shopify-section-{{ section.id }} .au__r svg{flex:0 0 auto;color:var(--a);margin-top:2px}
#shopify-section-{{ section.id }} .au__r b{display:block;font-size:15px;font-weight:700;letter-spacing:-.015em;margin-bottom:3px;color:var(--ink)}
#shopify-section-{{ section.id }} .au__r span{font-size:14px;line-height:1.58;color:var(--muted)}
#shopify-section-{{ section.id }} .au__lg{margin-top:28px;font-size:12.5px;line-height:1.6;color:color-mix(in srgb,var(--ink) 48%,transparent);padding-top:20px;border-top:1px solid var(--line)}
@media(max-width:880px){#shopify-section-{{ section.id }} .au__g{grid-template-columns:1fr;gap:34px}}
</style>
<div class="nvd au"><div class="nvd__in--n au__g">
<div class="au__seal">{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy" width="800" height="800">{%- else -%}<svg width="100%" viewBox="0 0 240 240" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="120" cy="120" r="96" stroke="{{ section.settings.accent_color }}" stroke-opacity=".2" stroke-width="2"/><circle cx="120" cy="120" r="80" stroke="{{ section.settings.accent_color }}" stroke-opacity=".35" stroke-width="1.5" stroke-dasharray="5 7"/><path d="M120 46l58 26v42c0 36-24.5 65.5-58 74-33.5-8.5-58-38-58-74V72z" fill="#fff" stroke="{{ section.settings.accent_color }}" stroke-width="3.5" stroke-linejoin="round"/><path d="M96 118l17 17 34-36" stroke="{{ section.settings.accent_color }}" stroke-width="11" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endif -%}</div>
<div><h2 class="nvd__h">{{ section.settings.heading }}</h2><p class="au__lead">{{ section.settings.subheading }}</p>
<div class="au__l">{%- for block in section.blocks -%}<div class="au__r" {{ block.shopify_attributes }}><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg><div><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div></div>{%- endfor -%}</div>
{%- if section.settings.legal != blank -%}<p class="au__lg">{{ section.settings.legal }}</p>{%- endif -%}
</div>
</div></div>
{% schema %}
{"name":"NVD — Authenticité","tag":"section","settings":[{"type":"text","id":"heading","label":"Titre","default":"Authentique, ou remboursé"},{"type":"textarea","id":"subheading","label":"Sous-titre","default":"Le doute est légitime quand un prix est bas. Voici ce que vous pouvez vérifier vous-même."},{"type":"image_picker","id":"image","label":"Image (vide = visuel généré)"},{"type":"textarea","id":"legal","label":"Mention légale","default":"Novadestock n'est pas affilié à Apple Inc. Apple, AirPods, iPhone et Apple Watch sont des marques déposées d'Apple Inc. Novadestock est un revendeur indépendant."},{"type":"header","content":"Couleurs & espacements"},{"type":"color","id":"accent_color","label":"Accent","default":"#127aa9"},{"type":"color","id":"text_color","label":"Texte","default":"#0A0A0A"},{"type":"color","id":"background_color","label":"Fond","default":"#FFFFFF"},{"type":"range","id":"padding_top","min":0,"max":160,"step":4,"unit":"px","label":"Marge haute","default":76},{"type":"range","id":"padding_bottom","min":0,"max":160,"step":4,"unit":"px","label":"Marge basse","default":76}],"blocks":[{"type":"point","name":"Garantie","settings":[{"type":"text","id":"title","label":"Titre","default":"Titre"},{"type":"textarea","id":"text","label":"Texte","default":"Description"}]}],"presets":[{"name":"NVD — Authenticité","blocks":[{"type":"point","settings":{"title":"Numéro de série vérifiable chez Apple","text":"Saisissez-le sur le site officiel d'Apple pour confirmer le modèle."}},{"type":"point","settings":{"title":"Emballage constructeur jamais ouvert","text":"Les produits arrivent sous blister d'origine."}},{"type":"point","settings":{"title":"Facture française nominative","text":"Jointe à chaque commande, elle prouve l'origine du produit."}},{"type":"point","settings":{"title":"Garantie légale de conformité 2 ans","text":"La même protection qu'un achat en magasin."}},{"type":"point","settings":{"title":"14 jours pour changer d'avis","text":"Retour gratuit et sans justification."}}]}]}
{% endschema %}