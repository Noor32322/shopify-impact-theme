{%- comment -%}NOVADESTOCK — Grille produits (sélection manuelle){%- endcomment -%}
{% render 'nvd-css', accent: section.settings.accent_color, ink: section.settings.text_color %}
<style>
#shopify-section-{{ section.id }} .pg{background:{{ section.settings.background_color }};padding:{{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px}
#shopify-section-{{ section.id }} .pg__h{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:36px;flex-wrap:wrap}
#shopify-section-{{ section.id }} .pg__h p{font-size:15.5px;line-height:1.55;margin:8px 0 0;max-width:54ch;color:var(--muted)}
#shopify-section-{{ section.id }} .pg__all{font-size:14.5px;font-weight:700;text-decoration:none;white-space:nowrap;color:var(--a);display:inline-flex;align-items:center;gap:7px}
#shopify-section-{{ section.id }} .pg__g{display:grid;grid-template-columns:repeat({{ section.settings.columns }},1fr);gap:20px}
#shopify-section-{{ section.id }} .pc{overflow:hidden;text-decoration:none;display:flex;flex-direction:column;transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease}
#shopify-section-{{ section.id }} a.pc:hover{transform:translateY(-4px);border-color:color-mix(in srgb,var(--a) 35%,transparent);box-shadow:0 14px 34px rgba(10,10,10,.07)}
#shopify-section-{{ section.id }} .pc__m{position:relative;aspect-ratio:1/1;background:#F4F6F8;display:grid;place-items:center;overflow:hidden}
#shopify-section-{{ section.id }} .pc__m img{width:100%;height:100%;object-fit:cover;display:block}
#shopify-section-{{ section.id }} .pc__b{position:absolute;top:12px;left:12px;background:{{ section.settings.badge_color }};color:#fff;font-size:12px;font-weight:800;padding:6px 12px;border-radius:100px}
#shopify-section-{{ section.id }} .pc__tag{position:absolute;top:12px;right:12px;background:var(--ink);color:#fff;font-size:11px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;padding:6px 11px;border-radius:100px}
#shopify-section-{{ section.id }} .pc__body{padding:18px 18px 20px;display:flex;flex-direction:column;gap:8px;flex:1}
#shopify-section-{{ section.id }} .pc__t{font-size:15px;font-weight:700;letter-spacing:-.015em;margin:0;color:var(--ink);line-height:1.35}
#shopify-section-{{ section.id }} .pc__a{font-size:12.5px;font-weight:600;display:inline-flex;align-items:center;gap:6px;color:var(--a)}
#shopify-section-{{ section.id }} .pc__p{display:flex;align-items:baseline;gap:9px;margin-top:auto;padding-top:6px}
#shopify-section-{{ section.id }} .pc__now{font-size:20px;font-weight:800;letter-spacing:-.02em;color:var(--ink)}
#shopify-section-{{ section.id }} .pc__old{font-size:14px;text-decoration:line-through;color:color-mix(in srgb,var(--ink) 42%,transparent)}
#shopify-section-{{ section.id }} .pc__s{font-size:12.5px;color:color-mix(in srgb,var(--ink) 55%,transparent)}
#shopify-section-{{ section.id }} .pc__empty{display:grid;place-items:center;padding:40px 18px;text-align:center;font-size:13.5px;color:var(--muted)}
@media(max-width:1000px){#shopify-section-{{ section.id }} .pg__g{grid-template-columns:repeat(3,1fr)}}
@media(max-width:760px){#shopify-section-{{ section.id }} .pg__g{grid-template-columns:repeat(2,1fr);gap:14px}}
</style>
<div class="nvd pg"><div class="nvd__in">
<div class="pg__h"><div><h2 class="nvd__h" style="margin-bottom:0">{{ section.settings.heading }}</h2>{%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}</div>{%- if section.settings.link_label != blank and section.settings.link_url != blank -%}<a class="pg__all" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>{%- endif -%}</div>
<div class="pg__g">
{%- for block in section.blocks -%}
{%- assign p = block.settings.product -%}
{%- if p != blank -%}
<a class="nvd__card pc" href="{{ p.url }}" {{ block.shopify_attributes }}><div class="pc__m">{%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 700 }}" alt="{{ p.featured_image.alt | escape }}" loading="lazy" width="700" height="700">{%- else -%}<svg width="44%" viewBox="0 0 120 120" fill="none" stroke="{{ section.settings.accent_color }}" stroke-opacity=".45" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><rect x="18" y="14" width="84" height="92" rx="14"/><circle cx="60" cy="52" r="17"/><path d="M40 88h40"/></svg>{%- endif -%}{%- if p.compare_at_price > p.price -%}{%- assign d = p.compare_at_price | minus: p.price | times: 100.0 | divided_by: p.compare_at_price | round -%}<span class="pc__b">-{{ d }} %</span>{%- endif -%}{%- if block.settings.tag != blank -%}<span class="pc__tag">{{ block.settings.tag }}</span>{%- endif -%}</div><div class="pc__body"><span class="pc__a"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>{{ section.settings.auth_label }}</span><p class="pc__t">{% if block.settings.custom_title != blank %}{{ block.settings.custom_title }}{% else %}{{ p.title }}{% endif %}</p><div class="pc__p"><span class="pc__now">{{ p.price | money }}</span>{%- if p.compare_at_price > p.price -%}<span class="pc__old">{{ p.compare_at_price | money }}</span>{%- endif -%}</div><span class="pc__s">{{ section.settings.ship_label }}</span></div></a>
{%- else -%}
<div class="nvd__card pc" {{ block.shopify_attributes }}><div class="pc__m"><svg width="44%" viewBox="0 0 120 120" fill="none" stroke="{{ section.settings.accent_color }}" stroke-opacity=".45" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><rect x="18" y="14" width="84" height="92" rx="14"/><circle cx="60" cy="52" r="17"/><path d="M40 88h40"/></svg></div><div class="pc__empty">Choisissez un produit dans cette case</div></div>
{%- endif -%}
{%- endfor -%}
{%- if section.blocks.size == 0 -%}<div class="nvd__card pc"><div class="pc__empty">Ajoutez une case produit à cette section</div></div>{%- endif -%}
</div></div></div>
{% schema %}
{"name":"NVD — Grille produits","tag":"section","max_blocks":12,"settings":[{"type":"text","id":"heading","label":"Titre","default":"Le stock du moment"},{"type":"textarea","id":"subheading","label":"Sous-titre","default":"Quantités réelles, pas de précommande."},{"type":"text","id":"link_label","label":"Lien tout voir","default":"Tout voir"},{"type":"url","id":"link_url","label":"Destination du lien"},{"type":"text","id":"auth_label","label":"Mention authenticité","default":"Authentique · neuf scellé"},{"type":"text","id":"ship_label","label":"Mention livraison","default":"Livraison offerte · 3 à 7 jours"},{"type":"range","id":"columns","min":2,"max":5,"step":1,"label":"Colonnes (ordinateur)","default":4},{"type":"header","content":"Couleurs & espacements"},{"type":"color","id":"accent_color","label":"Accent","default":"#127aa9"},{"type":"color","id":"badge_color","label":"Badge remise","default":"#FF3B30"},{"type":"color","id":"text_color","label":"Texte","default":"#0A0A0A"},{"type":"color","id":"background_color","label":"Fond","default":"#FFFFFF"},{"type":"range","id":"padding_top","min":0,"max":160,"step":4,"unit":"px","label":"Marge haute","default":72},{"type":"range","id":"padding_bottom","min":0,"max":160,"step":4,"unit":"px","label":"Marge basse","default":72}],"blocks":[{"type":"product","name":"Case produit","settings":[{"type":"product","id":"product","label":"Produit à afficher"},{"type":"text","id":"tag","label":"Étiquette d'angle (videz pour masquer)","default":"—"},{"type":"text","id":"custom_title","label":"Titre personnalisé (sinon titre du produit)","default":"—"}]}],"presets":[{"name":"NVD — Grille produits","blocks":[{"type":"product"},{"type":"product"},{"type":"product"},{"type":"product"}]}]}
{% endschema %}