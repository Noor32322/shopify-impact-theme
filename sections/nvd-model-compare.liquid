{%- comment -%}NOVADESTOCK — Comparatif modèles{%- endcomment -%}
{% render 'nvd-css', accent: section.settings.accent_color, ink: section.settings.text_color %}
<style>
#shopify-section-{{ section.id }} .mc{background:{{ section.settings.background_color }};padding:{{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px}
#shopify-section-{{ section.id }} .nvd__tbl{min-width:820px}
#shopify-section-{{ section.id }} .nvd__tbl td{text-align:left;vertical-align:middle}
#shopify-section-{{ section.id }} .nvd__tbl tbody tr:hover td{background:color-mix(in srgb,var(--a) 4%,transparent)}
#shopify-section-{{ section.id }} .mc__n{font-weight:700;color:var(--ink);letter-spacing:-.015em;font-size:15px}
#shopify-section-{{ section.id }} .mc__p{font-weight:800;color:var(--a);font-size:16px;white-space:nowrap}
#shopify-section-{{ section.id }} .mc__o{display:block;font-weight:500;font-size:12.5px;text-decoration:line-through;color:color-mix(in srgb,var(--ink) 42%,transparent)}
#shopify-section-{{ section.id }} .mc__tag{display:inline-block;font-size:10.5px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;padding:4px 9px;border-radius:6px;margin-left:8px;vertical-align:middle;background:{{ section.settings.tag_color }};color:#fff}
#shopify-section-{{ section.id }} .mc__buy{display:inline-block;padding:9px 18px;border-radius:100px;font-size:13px;font-weight:700;text-decoration:none;background:var(--a);color:#fff;white-space:nowrap}
#shopify-section-{{ section.id }} .mc__hint{text-align:center;font-size:13px;margin:18px 0 0;color:color-mix(in srgb,var(--ink) 50%,transparent)}
</style>
<div class="nvd mc"><div class="nvd__in">
<div class="nvd__head"><h2 class="nvd__h">{{ section.settings.heading }}</h2>{%- if section.settings.subheading != blank -%}<p class="nvd__s">{{ section.settings.subheading }}</p>{%- endif -%}</div>
<div class="nvd__scroll"><table class="nvd__tbl"><thead><tr><th>{{ section.settings.h_model }}</th><th>{{ section.settings.h_price }}</th><th>{{ section.settings.h_anc }}</th><th>{{ section.settings.h_battery }}</th><th>{{ section.settings.h_format }}</th><th>{{ section.settings.h_for }}</th><th></th></tr></thead><tbody>
{%- for block in section.blocks -%}<tr {{ block.shopify_attributes }}><td><span class="mc__n">{{ block.settings.model }}</span>{%- if block.settings.tag != blank -%}<span class="mc__tag">{{ block.settings.tag }}</span>{%- endif -%}</td><td><span class="mc__p">{{ block.settings.price }}</span>{%- if block.settings.old_price != blank -%}<span class="mc__o">{{ block.settings.old_price }}</span>{%- endif -%}</td><td>{%- if block.settings.anc -%}<svg class="nvd__yes" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>{%- else -%}<svg class="nvd__no" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>{%- endif -%}</td><td>{{ block.settings.battery }}</td><td>{{ block.settings.format }}</td><td>{{ block.settings.best_for }}</td><td>{%- if block.settings.link != blank -%}<a class="mc__buy" href="{{ block.settings.link }}">{{ section.settings.buy_label }}</a>{%- endif -%}</td></tr>{%- endfor -%}
</tbody></table></div>
{%- if section.settings.hint != blank -%}<p class="mc__hint">{{ section.settings.hint }}</p>{%- endif -%}
</div></div>
{% schema %}
{"name":"NVD — Comparatif modèles","tag":"section","settings":[{"type":"text","id":"heading","label":"Titre","default":"Quel modèle d'AirPods choisir ?"},{"type":"textarea","id":"subheading","label":"Sous-titre","default":"Toute la gamme comparée ligne par ligne."},{"type":"text","id":"hint","label":"Note sous le tableau","default":"Prix TTC, livraison offerte incluse."},{"type":"text","id":"buy_label","label":"Texte du bouton","default":"Voir"},{"type":"header","content":"En-têtes de colonnes"},{"type":"text","id":"h_model","label":"Colonne modèle","default":"Modèle"},{"type":"text","id":"h_price","label":"Colonne prix","default":"Notre prix"},{"type":"text","id":"h_anc","label":"Colonne réduction de bruit","default":"Réduction de bruit"},{"type":"text","id":"h_battery","label":"Colonne autonomie","default":"Autonomie"},{"type":"text","id":"h_format","label":"Colonne format","default":"Format"},{"type":"text","id":"h_for","label":"Colonne recommandation","default":"Idéal pour"},{"type":"header","content":"Couleurs & espacements"},{"type":"color","id":"accent_color","label":"Accent","default":"#127aa9"},{"type":"color","id":"tag_color","label":"Étiquettes","default":"#FF3B30"},{"type":"color","id":"text_color","label":"Texte","default":"#0A0A0A"},{"type":"color","id":"background_color","label":"Fond","default":"#F4F6F8"},{"type":"range","id":"padding_top","min":0,"max":160,"step":4,"unit":"px","label":"Marge haute","default":76},{"type":"range","id":"padding_bottom","min":0,"max":160,"step":4,"unit":"px","label":"Marge basse","default":76}],"blocks":[{"type":"model","name":"Modèle","settings":[{"type":"text","id":"model","label":"Nom du modèle","default":"AirPods"},{"type":"text","id":"tag","label":"Étiquette (videz pour masquer)","default":"—"},{"type":"text","id":"price","label":"Notre prix","default":"0 €"},{"type":"text","id":"old_price","label":"Prix barré (videz pour masquer)","default":"—"},{"type":"checkbox","id":"anc","label":"Réduction de bruit active","default":false},{"type":"text","id":"battery","label":"Autonomie","default":"5 h"},{"type":"text","id":"format","label":"Format","default":"Ouvert"},{"type":"text","id":"best_for","label":"Idéal pour","default":"Usage quotidien"},{"type":"url","id":"link","label":"Lien produit"}]}],"presets":[{"name":"NVD — Comparatif modèles","blocks":[{"type":"model","settings":{"model":"AirPods 4","price":"79 €","old_price":"149 €","anc":false,"battery":"5 h","format":"Ouvert","best_for":"Usage quotidien"}},{"type":"model","settings":{"model":"AirPods Pro 3","tag":"Le plus vendu","price":"159 €","old_price":"249 €","anc":true,"battery":"8 h","format":"Intra","best_for":"Transports, avion, sport"}}]}]}
{% endschema %}