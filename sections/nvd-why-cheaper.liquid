{%- comment -%}NOVADESTOCK — Pourquoi moins cher{%- endcomment -%}
{% render 'nvd-css', accent: section.settings.accent_color, ink: section.settings.text_color %}
<style>
#shopify-section-{{ section.id }} .wc{background:{{ section.settings.background_color }};padding:{{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px}
#shopify-section-{{ section.id }} .wc__g{display:grid;grid-template-columns:repeat({{ section.blocks.size | at_most: 3 }},1fr);gap:22px}
#shopify-section-{{ section.id }} .wc__c{padding:30px 26px}
#shopify-section-{{ section.id }} .wc__n{width:36px;height:36px;border-radius:10px;display:grid;place-items:center;background:var(--a);color:#fff;font-weight:800;font-size:15px;margin-bottom:18px}
#shopify-section-{{ section.id }} .wc__c h3{font-size:17px;font-weight:700;letter-spacing:-.015em;margin:0 0 9px;color:var(--ink)}
#shopify-section-{{ section.id }} .wc__c p{font-size:14.5px;line-height:1.62;margin:0;color:var(--muted)}
#shopify-section-{{ section.id }} .wc__note{margin-top:26px;display:flex;gap:13px;align-items:flex-start;background:var(--soft);border:1px solid color-mix(in srgb,var(--a) 20%,transparent);border-radius:16px;padding:20px 22px}
#shopify-section-{{ section.id }} .wc__note svg{flex:0 0 auto;color:var(--a);margin-top:1px}
#shopify-section-{{ section.id }} .wc__note p{margin:0;font-size:14.5px;line-height:1.6;color:var(--ink)}
@media(max-width:880px){#shopify-section-{{ section.id }} .wc__g{grid-template-columns:1fr}}
</style>
<div class="nvd wc" id="pourquoi"><div class="nvd__in--n">
<div class="nvd__head"><h2 class="nvd__h">{{ section.settings.heading }}</h2>{%- if section.settings.subheading != blank -%}<p class="nvd__s">{{ section.settings.subheading }}</p>{%- endif -%}</div>
<div class="wc__g">{%- for block in section.blocks -%}<div class="nvd__card wc__c" {{ block.shopify_attributes }}><div class="wc__n">{{ forloop.index }}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>{%- endfor -%}</div>
{%- if section.settings.note != blank -%}<div class="wc__note"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 16v-5M12 8h.01"/></svg><p>{{ section.settings.note }}</p></div>{%- endif -%}
</div></div>
{% schema %}
{"name":"NVD — Pourquoi moins cher","tag":"section","max_blocks":3,"settings":[{"type":"text","id":"heading","label":"Titre","default":"Pourquoi c'est jusqu'à 60 % moins cher"},{"type":"textarea","id":"subheading","label":"Sous-titre","default":"Aucune magie, aucune contrefaçon."},{"type":"textarea","id":"note","label":"Encadré d'information","default":"Numéro de série vérifiable sur le site officiel d'Apple."},{"type":"header","content":"Couleurs & espacements"},{"type":"color","id":"accent_color","label":"Accent","default":"#127aa9"},{"type":"color","id":"text_color","label":"Texte","default":"#0A0A0A"},{"type":"color","id":"background_color","label":"Fond","default":"#F4F6F8"},{"type":"range","id":"padding_top","min":0,"max":160,"step":4,"unit":"px","label":"Marge haute","default":76},{"type":"range","id":"padding_bottom","min":0,"max":160,"step":4,"unit":"px","label":"Marge basse","default":76}],"blocks":[{"type":"step","name":"Étape","settings":[{"type":"text","id":"title","label":"Titre","default":"Titre"},{"type":"textarea","id":"text","label":"Texte","default":"Description."}]}],"presets":[{"name":"NVD — Pourquoi moins cher","blocks":[{"type":"step","settings":{"title":"Apple sort une nouvelle génération","text":"Les modèles de l'année précédente deviennent des fins de série."}},{"type":"step","settings":{"title":"Les distributeurs vident leurs entrepôts","text":"Ils cèdent les lots bien en dessous du prix public."}},{"type":"step","settings":{"title":"On achète le lot, vous payez le vrai prix","text":"Même produit, même garantie — le prix en moins."}}]}]}
{% endschema %}