{%- comment -%}NOVADESTOCK — Hero{%- endcomment -%}
{% render 'nvd-css', accent: section.settings.accent_color, ink: section.settings.text_color %}
<style>
#shopify-section-{{ section.id }} .h{background:{{ section.settings.background_color }};padding:{{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px}
#shopify-section-{{ section.id }} .h__g{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center}
#shopify-section-{{ section.id }} .h__eye{display:inline-flex;align-items:center;gap:8px;font-size:12px;letter-spacing:.12em;text-transform:uppercase;font-weight:800;color:var(--a);background:var(--soft);border:1px solid color-mix(in srgb,var(--a) 22%,transparent);padding:8px 15px;border-radius:100px;margin-bottom:24px}
#shopify-section-{{ section.id }} h1{font-size:clamp(34px,4.4vw,58px);line-height:1.04;letter-spacing:-.035em;margin:0 0 20px;color:var(--ink);font-weight:800}
#shopify-section-{{ section.id }} .h__sub{font-size:17px;line-height:1.62;color:var(--muted);margin:0 0 30px;max-width:50ch}
#shopify-section-{{ section.id }} .h__cta{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:32px}
#shopify-section-{{ section.id }} .h__proof{display:flex;flex-wrap:wrap;gap:11px 26px;padding-top:26px;border-top:1px solid var(--line)}
#shopify-section-{{ section.id }} .h__proof span{display:inline-flex;align-items:center;gap:8px;font-size:13.5px;font-weight:600;color:color-mix(in srgb,var(--ink) 72%,transparent)}
#shopify-section-{{ section.id }} .h__proof svg{flex:0 0 auto;color:var(--a)}
#shopify-section-{{ section.id }} .h__vis{position:relative}
#shopify-section-{{ section.id }} .h__vis img{width:100%;height:auto;display:block;border-radius:26px}
#shopify-section-{{ section.id }} .h__fig{border-radius:28px;overflow:hidden;background:linear-gradient(150deg,color-mix(in srgb,var(--a) 14%,#fff),#fff 70%);border:1px solid color-mix(in srgb,var(--a) 16%,transparent);aspect-ratio:4/3.4;display:grid;place-items:center}
#shopify-section-{{ section.id }} .h__bdg{position:absolute;top:20px;right:20px;background:{{ section.settings.badge_color }};color:#fff;border-radius:100px;padding:11px 20px;font-weight:800;font-size:15px;box-shadow:0 10px 26px color-mix(in srgb,{{ section.settings.badge_color }} 35%,transparent)}
@media(max-width:900px){#shopify-section-{{ section.id }} .h__g{grid-template-columns:1fr;gap:36px}#shopify-section-{{ section.id }} .h__vis{order:-1}}
</style>
<div class="nvd h"><div class="nvd__in h__g">
<div>
{%- if section.settings.eyebrow != blank -%}<span class="h__eye"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="12"/></svg>{{ section.settings.eyebrow }}</span>{%- endif -%}
<h1>{{ section.settings.heading }}</h1>
{%- if section.settings.subheading != blank -%}<p class="h__sub">{{ section.settings.subheading }}</p>{%- endif -%}
<div class="h__cta">
{%- if section.settings.button_label != blank -%}<a class="nvd__btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>{%- endif -%}
{%- if section.settings.button2_label != blank -%}<a class="nvd__btn nvd__btn--g" href="{{ section.settings.button2_link | default: '#' }}">{{ section.settings.button2_label }}</a>{%- endif -%}
</div>
<div class="h__proof">{%- for block in section.blocks -%}<span {{ block.shopify_attributes }}><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>{{ block.settings.text }}</span>{%- endfor -%}</div>
</div>
<div class="h__vis">
{%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" height="1020">
{%- else -%}<div class="h__fig"><svg width="62%" viewBox="0 0 300 300" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="52" y="34" width="196" height="232" rx="26" fill="#fff" stroke="{{ section.settings.accent_color }}" stroke-opacity=".3" stroke-width="2.5"/><circle cx="150" cy="128" r="46" fill="{{ section.settings.accent_color }}" fill-opacity=".1"/><path d="M128 128l15 15 30-31" stroke="{{ section.settings.accent_color }}" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"/><rect x="92" y="196" width="116" height="9" rx="4.5" fill="{{ section.settings.accent_color }}" fill-opacity=".22"/><rect x="112" y="216" width="76" height="9" rx="4.5" fill="{{ section.settings.accent_color }}" fill-opacity=".12"/></svg></div>{%- endif -%}
{%- if section.settings.badge_text != blank -%}<div class="h__bdg">{{ section.settings.badge_text }}</div>{%- endif -%}
</div>
</div></div>
{% schema %}
{"name":"NVD — Hero","tag":"section","settings":[{"type":"header","content":"Contenu"},{"type":"text","id":"eyebrow","label":"Sur-titre","default":"Déstockage officiel · Stock limité"},{"type":"text","id":"heading","label":"Titre principal","default":"Le vrai Apple. Au prix du déstockage."},{"type":"textarea","id":"subheading","label":"Sous-titre","default":"Des AirPods authentiques, neufs et scellés."},{"type":"header","content":"Boutons"},{"type":"text","id":"button_label","label":"Bouton principal","default":"Voir le catalogue"},{"type":"url","id":"button_link","label":"Lien bouton principal"},{"type":"text","id":"button2_label","label":"Bouton secondaire","default":"En savoir plus"},{"type":"url","id":"button2_link","label":"Lien bouton secondaire"},{"type":"header","content":"Visuel"},{"type":"image_picker","id":"image","label":"Image (vide = visuel généré)"},{"type":"text","id":"badge_text","label":"Badge remise","default":"Jusqu'à -67 %"},{"type":"color","id":"badge_color","label":"Couleur du badge","default":"#FF3B30"},{"type":"header","content":"Couleurs & espacements"},{"type":"color","id":"accent_color","label":"Accent","default":"#127aa9"},{"type":"color","id":"text_color","label":"Texte","default":"#0A0A0A"},{"type":"color","id":"background_color","label":"Fond","default":"#FFFFFF"},{"type":"range","id":"padding_top","min":0,"max":160,"step":4,"unit":"px","label":"Marge haute","default":72},{"type":"range","id":"padding_bottom","min":0,"max":160,"step":4,"unit":"px","label":"Marge basse","default":64}],"blocks":[{"type":"proof","name":"Point de réassurance","settings":[{"type":"text","id":"text","label":"Texte","default":"Produits authentiques"}]}],"presets":[{"name":"NVD — Hero","blocks":[{"type":"proof","settings":{"text":"100 % authentique Apple"}},{"type":"proof","settings":{"text":"Livraison offerte"}},{"type":"proof","settings":{"text":"Garantie 2 ans"}},{"type":"proof","settings":{"text":"Facture fournie"}}]}]}
{% endschema %}