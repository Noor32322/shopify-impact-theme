{%- comment -%}NOVADESTOCK — FAQ{%- endcomment -%}
{% render 'nvd-css', accent: section.settings.accent_color, ink: section.settings.text_color %}
<style>
#shopify-section-{{ section.id }} .fq{background:{{ section.settings.background_color }};padding:{{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px}
#shopify-section-{{ section.id }} .fq__in{max-width:780px;margin:0 auto}
#shopify-section-{{ section.id }} details{background:#fff;border:1px solid var(--line);border-radius:16px;margin-bottom:11px;overflow:hidden;transition:border-color .18s ease}
#shopify-section-{{ section.id }} details[open]{border-color:color-mix(in srgb,var(--a) 40%,transparent)}
#shopify-section-{{ section.id }} summary{list-style:none;cursor:pointer;padding:20px 22px;display:flex;justify-content:space-between;align-items:center;gap:16px;font-weight:650;font-size:15.5px;letter-spacing:-.01em;color:var(--ink)}
#shopify-section-{{ section.id }} summary::-webkit-details-marker{display:none}
#shopify-section-{{ section.id }} .fq__ic{flex:0 0 auto;color:var(--a);transition:transform .22s ease}
#shopify-section-{{ section.id }} details[open] .fq__ic{transform:rotate(45deg)}
#shopify-section-{{ section.id }} .fq__b{padding:0 22px 22px;font-size:14.8px;line-height:1.68;color:var(--muted)}
#shopify-section-{{ section.id }} .fq__b p{margin:0 0 10px}
#shopify-section-{{ section.id }} .fq__b p:last-child{margin-bottom:0}
</style>
<div class="nvd fq"><div class="fq__in">
<div class="nvd__head"><h2 class="nvd__h">{{ section.settings.heading }}</h2>{%- if section.settings.subheading != blank -%}<p class="nvd__s">{{ section.settings.subheading }}</p>{%- endif -%}</div>
{%- for block in section.blocks -%}<details {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}><summary>{{ block.settings.question }}<svg class="fq__ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></summary><div class="fq__b">{{ block.settings.answer }}</div></details>{%- endfor -%}
</div></div>
{% schema %}
{"name":"NVD — FAQ","tag":"section","settings":[{"type":"text","id":"heading","label":"Titre","default":"Les questions qu'on nous pose"},{"type":"textarea","id":"subheading","label":"Sous-titre","default":"Une question qui n'est pas ici ? Écrivez-nous."},{"type":"header","content":"Couleurs & espacements"},{"type":"color","id":"accent_color","label":"Accent","default":"#127aa9"},{"type":"color","id":"text_color","label":"Texte","default":"#0A0A0A"},{"type":"color","id":"background_color","label":"Fond","default":"#F4F6F8"},{"type":"range","id":"padding_top","min":0,"max":160,"step":4,"unit":"px","label":"Marge haute","default":76},{"type":"range","id":"padding_bottom","min":0,"max":160,"step":4,"unit":"px","label":"Marge basse","default":76}],"blocks":[{"type":"q","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"Votre question"},{"type":"richtext","id":"answer","label":"Réponse","default":"<p>Votre réponse.</p>"},{"type":"checkbox","id":"open","label":"Ouverte par défaut","default":false}]}],"presets":[{"name":"NVD — FAQ","blocks":[{"type":"q","settings":{"open":true,"question":"Les produits sont-ils vraiment authentiques ?","answer":"<p>Oui. Produits Apple d'origine, neufs et scellés. Numéro de série vérifiable sur le site officiel d'Apple.</p>"}},{"type":"q","settings":{"question":"Pourquoi vos prix sont-ils aussi bas ?","answer":"<p>Nous achetons des lots de fin de série auprès de distributeurs européens.</p>"}},{"type":"q","settings":{"question":"Quel est le délai de livraison ?","answer":"<p>Entre 3 et 7 jours ouvrés en France métropolitaine. Livraison offerte.</p>"}},{"type":"q","settings":{"question":"Ai-je une garantie ?","answer":"<p>Oui, la garantie légale de conformité de 2 ans s'applique.</p>"}}]}]}
{% endschema %}