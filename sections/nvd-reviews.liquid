{%- comment -%}NOVADESTOCK — Avis clients{%- endcomment -%}
{% render 'nvd-css', accent: section.settings.accent_color, ink: section.settings.text_color %}
{%- assign slider = false -%}{%- if section.settings.layout == 'slider' -%}{%- assign slider = true -%}{%- endif -%}
<style>
#shopify-section-{{ section.id }} .rv{background:{{ section.settings.background_color }};padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;scroll-margin-top:90px}
#shopify-section-{{ section.id }} .rv__in{max-width:1180px;margin:0 auto;padding:0 20px}
#shopify-section-{{ section.id }} .rv__bar{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:32px;flex-wrap:wrap}
#shopify-section-{{ section.id }} .rv__bar h2{margin-bottom:10px}
#shopify-section-{{ section.id }} .rv__nav{display:flex;gap:9px;flex:0 0 auto}
#shopify-section-{{ section.id }} .rv__ar{width:44px;height:44px;border-radius:50%;border:1.5px solid var(--line);background:#fff;color:var(--ink);display:grid;place-items:center;cursor:pointer;transition:border-color .18s ease,color .18s ease,opacity .18s ease}
#shopify-section-{{ section.id }} .rv__ar:hover{border-color:var(--a);color:var(--a)}
#shopify-section-{{ section.id }} .rv__ar[disabled]{opacity:.3;cursor:default;border-color:var(--line);color:var(--ink)}
{%- if slider -%}
#shopify-section-{{ section.id }} .rv__g{display:flex;gap:{{ section.settings.gap }}px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;align-items:flex-start;padding:4px 20px 8px;max-width:1220px;margin:0 auto;-webkit-overflow-scrolling:touch;scrollbar-width:none}
#shopify-section-{{ section.id }} .rv__g::-webkit-scrollbar{display:none}
#shopify-section-{{ section.id }} .rv__c{flex:0 0 {{ section.settings.card_width }}px;scroll-snap-align:start}
@media(max-width:680px){#shopify-section-{{ section.id }} .rv__c{flex:0 0 78%}}
{%- else -%}
#shopify-section-{{ section.id }} .rv__g{display:grid;grid-template-columns:repeat({{ section.settings.columns }},1fr);gap:{{ section.settings.gap }}px;align-items:start;max-width:1180px;margin:0 auto;padding:0 20px}
@media(max-width:1000px){#shopify-section-{{ section.id }} .rv__g{grid-template-columns:repeat(2,1fr)}}
@media(max-width:680px){#shopify-section-{{ section.id }} .rv__g{grid-template-columns:1fr}}
{%- endif -%}
#shopify-section-{{ section.id }} .rv__c{background:#fff;border:1px solid var(--line);border-radius:{{ section.settings.radius }}px;overflow:hidden;display:flex;flex-direction:column}
#shopify-section-{{ section.id }} .rv__img{display:block;width:100%;height:auto;margin:0}
#shopify-section-{{ section.id }} .rv__ph{width:100%;aspect-ratio:4/3;background:#F4F6F8;display:grid;place-items:center}
#shopify-section-{{ section.id }} .rv__b{padding:{{ section.settings.card_padding }}px;display:flex;flex-direction:column;gap:11px}
#shopify-section-{{ section.id }} .rv__stars{display:flex;align-items:center;gap:7px}
#shopify-section-{{ section.id }} .rv__s{display:inline-flex;gap:2px;color:{{ section.settings.star_color }}}
#shopify-section-{{ section.id }} .rv__n{font-size:13.5px;font-weight:700;color:color-mix(in srgb,var(--ink) 60%,transparent)}
#shopify-section-{{ section.id }} .rv__t{font-size:{{ section.settings.text_size }}px;line-height:1.62;margin:0;color:var(--ink)}
#shopify-section-{{ section.id }} .rv__who{display:flex;align-items:center;gap:10px;margin-top:2px}
#shopify-section-{{ section.id }} .rv__av{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;font-weight:800;font-size:13px;background:var(--soft);color:var(--a);flex:0 0 auto}
#shopify-section-{{ section.id }} .rv__name{font-size:14px;font-weight:700;margin:0;color:var(--ink);line-height:1.3}
#shopify-section-{{ section.id }} .rv__meta{font-size:12px;margin:2px 0 0;display:flex;align-items:center;gap:5px;color:color-mix(in srgb,var(--ink) 52%,transparent)}
#shopify-section-{{ section.id }} .rv__meta svg{color:var(--a);flex:0 0 auto}
#shopify-section-{{ section.id }} .rv__top{display:inline-flex;align-items:center;gap:9px;font-size:14.5px;font-weight:600;color:color-mix(in srgb,var(--ink) 62%,transparent);margin:0}
</style>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs><linearGradient id="nvdhalf-{{ section.id }}"><stop offset="50%" stop-color="{{ section.settings.star_color }}"/><stop offset="50%" stop-color="{{ section.settings.star_color }}" stop-opacity="0.22"/></linearGradient></defs></svg>
<div class="nvd rv" id="{{ section.settings.anchor_id | default: 'avis' }}">
<div class="rv__in">
<div class="rv__bar">
<div>
<h2 class="nvd__h">{{ section.settings.heading }}</h2>
{%- if section.settings.subheading != blank -%}<p class="nvd__s">{{ section.settings.subheading }}</p>{%- endif -%}
{%- if section.settings.global_note != blank -%}
<p class="rv__top" style="margin-top:14px"><span class="rv__s">{%- for i in (1..5) -%}<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3 6.9 7.5.7-5.6 5 1.6 7.4L12 18.3 5.5 22l1.6-7.4-5.6-5 7.5-.7z"/></svg>{%- endfor -%}</span>{{ section.settings.global_note }}</p>
{%- endif -%}
</div>
{%- if slider and section.settings.show_arrows -%}
<div class="rv__nav">
<button class="rv__ar" type="button" id="rvprev-{{ section.id }}" aria-label="Avis précédents"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6"/></svg></button>
<button class="rv__ar" type="button" id="rvnext-{{ section.id }}" aria-label="Avis suivants"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
</div>
{%- endif -%}
</div>
</div>
<div class="rv__g" id="rvtrack-{{ section.id }}">
{%- for block in section.blocks -%}
{%- assign r = block.settings.rating -%}
<div class="rv__c" {{ block.shopify_attributes }}>
{%- if block.settings.image != blank -%}
<img class="rv__img" src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image.alt | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
{%- elsif section.settings.show_placeholder -%}
<div class="rv__ph"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.accent_color }}" stroke-opacity=".4" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="9" r="1.8"/><path d="M21 15l-5-5L5 21"/></svg></div>
{%- endif -%}
<div class="rv__b">
<div class="rv__stars"><span class="rv__s">
{%- for i in (1..5) -%}{%- assign half = i | minus: 0.5 -%}{%- if r >= i -%}<svg width="{{ section.settings.star_size }}" height="{{ section.settings.star_size }}" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3 6.9 7.5.7-5.6 5 1.6 7.4L12 18.3 5.5 22l1.6-7.4-5.6-5 7.5-.7z"/></svg>{%- elsif r >= half -%}<svg width="{{ section.settings.star_size }}" height="{{ section.settings.star_size }}" viewBox="0 0 24 24" fill="url(#nvdhalf-{{ section.id }})"><path d="M12 2l3 6.9 7.5.7-5.6 5 1.6 7.4L12 18.3 5.5 22l1.6-7.4-5.6-5 7.5-.7z"/></svg>{%- else -%}<svg width="{{ section.settings.star_size }}" height="{{ section.settings.star_size }}" viewBox="0 0 24 24" fill="currentColor" opacity=".22"><path d="M12 2l3 6.9 7.5.7-5.6 5 1.6 7.4L12 18.3 5.5 22l1.6-7.4-5.6-5 7.5-.7z"/></svg>{%- endif -%}{%- endfor -%}
</span>{%- if section.settings.show_number -%}<span class="rv__n">{{ r }}/5</span>{%- endif -%}</div>
{%- if block.settings.text != blank -%}<p class="rv__t">{{ block.settings.text }}</p>{%- endif -%}
{%- if block.settings.name != blank -%}
<div class="rv__who">{%- if section.settings.show_avatar -%}<div class="rv__av">{{ block.settings.name | strip | slice: 0 | upcase }}</div>{%- endif -%}<div><p class="rv__name">{{ block.settings.name }}</p>{%- if block.settings.meta != blank -%}<p class="rv__meta">{%- if block.settings.verified -%}<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>{%- endif -%}{{ block.settings.meta }}</p>{%- endif -%}</div></div>
{%- endif -%}
</div>
</div>
{%- endfor -%}
</div>
</div>
{%- if slider and section.settings.show_arrows -%}
<script>
(function(){
  var sid = {{ section.id | json }};
  var t = document.getElementById('rvtrack-'+sid);
  var pv = document.getElementById('rvprev-'+sid), nx = document.getElementById('rvnext-'+sid);
  if(!t || !pv || !nx) return;
  function step(){ var c = t.querySelector('.rv__c'); return c ? c.offsetWidth + {{ section.settings.gap }} : 320; }
  function upd(){ pv.disabled = t.scrollLeft <= 4; nx.disabled = t.scrollLeft + t.clientWidth >= t.scrollWidth - 4; }
  pv.addEventListener('click', function(){ t.scrollBy({left: -step(), behavior:'smooth'}); });
  nx.addEventListener('click', function(){ t.scrollBy({left: step(), behavior:'smooth'}); });
  t.addEventListener('scroll', upd, {passive:true});
  window.addEventListener('resize', upd);
  upd();
})();
</script>
{%- endif -%}
{% schema %}
{"name":"NVD — Avis clients","tag":"section","max_blocks":16,"settings":[{"type":"text","id":"heading","label":"Titre","default":"Ce qu'en disent nos clients"},{"type":"textarea","id":"subheading","label":"Sous-titre","default":"Des avis de vraies commandes, avec photos."},{"type":"text","id":"global_note","label":"Note globale (videz pour masquer)","default":"—"},{"type":"text","id":"anchor_id","label":"Identifiant d'ancre (pour les liens #)","default":"avis"},{"type":"header","content":"Mise en page"},{"type":"select","id":"layout","label":"Disposition","default":"slider","options":[{"value":"slider","label":"Défilement horizontal"},{"value":"grid","label":"Grille"}]},{"type":"range","id":"card_width","min":220,"max":460,"step":10,"unit":"px","label":"Largeur des cartes (défilement)","default":320},{"type":"checkbox","id":"show_arrows","label":"Afficher les flèches (défilement)","default":true},{"type":"range","id":"columns","min":1,"max":4,"step":1,"label":"Colonnes (grille, ordinateur)","default":3},{"type":"range","id":"gap","min":8,"max":40,"step":2,"unit":"px","label":"Espace entre les cartes","default":20},{"type":"range","id":"radius","min":0,"max":32,"step":2,"unit":"px","label":"Arrondi des cartes","default":20},{"type":"range","id":"card_padding","min":12,"max":40,"step":2,"unit":"px","label":"Marge intérieure des cartes","default":22},{"type":"range","id":"text_size","min":12,"max":20,"step":1,"unit":"px","label":"Taille du texte de l'avis","default":15},{"type":"checkbox","id":"show_placeholder","label":"Afficher un cadre gris si aucune image","default":true},{"type":"checkbox","id":"show_avatar","label":"Afficher l'initiale du prénom","default":true},{"type":"header","content":"Étoiles"},{"type":"checkbox","id":"show_number","label":"Afficher la note chiffrée (4,5/5)","default":true},{"type":"range","id":"star_size","min":12,"max":26,"step":1,"unit":"px","label":"Taille des étoiles","default":16},{"type":"color","id":"star_color","label":"Couleur des étoiles","default":"#F5A623"},{"type":"header","content":"Couleurs & espacements"},{"type":"color","id":"accent_color","label":"Accent","default":"#127aa9"},{"type":"color","id":"text_color","label":"Texte","default":"#0A0A0A"},{"type":"color","id":"background_color","label":"Fond","default":"#F4F6F8"},{"type":"range","id":"padding_top","min":0,"max":160,"step":4,"unit":"px","label":"Marge haute","default":76},{"type":"range","id":"padding_bottom","min":0,"max":160,"step":4,"unit":"px","label":"Marge basse","default":76}],"blocks":[{"type":"review","name":"Avis","settings":[{"type":"image_picker","id":"image","label":"Photo de l'avis"},{"type":"range","id":"rating","min":0,"max":5,"step":0.5,"label":"Note","default":5},{"type":"textarea","id":"text","label":"Texte de l'avis","default":"Écrivez ici l'avis du client."},{"type":"text","id":"name","label":"Prénom","default":"Prénom"},{"type":"text","id":"meta","label":"Mention sous le prénom (videz pour masquer)","default":"Achat vérifié"},{"type":"checkbox","id":"verified","label":"Afficher la coche de vérification","default":true}]}],"presets":[{"name":"NVD — Avis clients","blocks":[{"type":"review"},{"type":"review"},{"type":"review"},{"type":"review"}]}]}
{% endschema %}