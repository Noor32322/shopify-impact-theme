{%- comment -%}NOVADESTOCK — Comparatif concurrence{%- endcomment -%}
{% render 'nvd-css', accent: section.settings.accent_color, ink: section.settings.text_color %}
<style>
#shopify-section-{{ section.id }} .cp{background:{{ section.settings.background_color }};padding:{{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px}
#shopify-section-{{ section.id }} .nvd__tbl{min-width:600px}
#shopify-section-{{ section.id }} .nvd__tbl th,#shopify-section-{{ section.id }} .nvd__tbl td{text-align:center}
#shopify-section-{{ section.id }} .nvd__tbl th:first-child,#shopify-section-{{ section.id }} .nvd__tbl td:first-child{text-align:left;font-weight:600;color:var(--ink);min-width:200px}
#shopify-section-{{ section.id }} .us{background:var(--soft)!important;color:var(--a)!important;font-weight:800!important}
#shopify-section-{{ section.id }} th.us{font-size:13px!important;border-bottom:2px solid var(--a)}
#shopify-section-{{ section.id }} .cp__cta{text-align:center;margin-top:34px}
</style>
<div class="nvd cp"><div class="nvd__in--n">
<div class="nvd__head"><h2 class="nvd__h">{{ section.settings.heading }}</h2>{%- if section.settings.subheading != blank -%}<p class="nvd__s">{{ section.settings.subheading }}</p>{%- endif -%}</div>
<div class="nvd__scroll"><table class="nvd__tbl"><thead><tr><th>{{ section.settings.col0 }}</th><th class="us">{{ section.settings.col1 }}</th><th>{{ section.settings.col2 }}</th><th>{{ section.settings.col3 }}</th></tr></thead><tbody>
{%- for block in section.blocks -%}<tr {{ block.shopify_attributes }}><td>{{ block.settings.label }}</td>
<td class="us">{%- if block.settings.v1 == 'yes' -%}<svg class="nvd__yes" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>{%- elsif block.settings.v1 == 'no' -%}<svg class="nvd__no" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>{%- else -%}{{ block.settings.v1_text }}{%- endif -%}</td>
<td>{%- if block.settings.v2 == 'yes' -%}<svg class="nvd__yes" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>{%- elsif block.settings.v2 == 'no' -%}<svg class="nvd__no" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>{%- else -%}{{ block.settings.v2_text }}{%- endif -%}</td>
<td>{%- if block.settings.v3 == 'yes' -%}<svg class="nvd__yes" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>{%- elsif block.settings.v3 == 'no' -%}<svg class="nvd__no" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>{%- else -%}{{ block.settings.v3_text }}{%- endif -%}</td></tr>{%- endfor -%}
</tbody></table></div>
{%- if section.settings.button_label != blank -%}<div class="cp__cta"><a class="nvd__btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a></div>{%- endif -%}
</div></div>
{% schema %}
{"name":"NVD — Vs concurrence","tag":"section","settings":[{"type":"text","id":"heading","label":"Titre","default":"Novadestock face aux autres"},{"type":"textarea","id":"subheading","label":"Sous-titre","default":"Le même produit Apple. Trois façons très différentes de l'acheter."},{"type":"header","content":"En-têtes de colonnes"},{"type":"text","id":"col0","label":"Colonne 1 (critère)","default":"Critère"},{"type":"text","id":"col1","label":"Colonne 2 (vous)","default":"Novadestock"},{"type":"text","id":"col2","label":"Colonne 3","default":"Apple Store"},{"type":"text","id":"col3","label":"Colonne 4","default":"Marketplaces"},{"type":"header","content":"Bouton"},{"type":"text","id":"button_label","label":"Texte du bouton","default":"Voir le catalogue"},{"type":"url","id":"button_link","label":"Lien"},{"type":"header","content":"Couleurs & espacements"},{"type":"color","id":"accent_color","label":"Accent","default":"#127aa9"},{"type":"color","id":"text_color","label":"Texte","default":"#0A0A0A"},{"type":"color","id":"background_color","label":"Fond","default":"#F4F6F8"},{"type":"range","id":"padding_top","min":0,"max":160,"step":4,"unit":"px","label":"Marge haute","default":76},{"type":"range","id":"padding_bottom","min":0,"max":160,"step":4,"unit":"px","label":"Marge basse","default":76}],"blocks":[{"type":"row","name":"Ligne","settings":[{"type":"text","id":"label","label":"Critère","default":"Critère"},{"type":"header","content":"Colonne Novadestock"},{"type":"select","id":"v1","label":"Type","default":"yes","options":[{"value":"yes","label":"Coche"},{"value":"no","label":"Croix"},{"value":"text","label":"Texte libre"}]},{"type":"text","id":"v1_text","label":"Texte","default":"—"},{"type":"header","content":"Colonne 3"},{"type":"select","id":"v2","label":"Type","default":"text","options":[{"value":"yes","label":"Coche"},{"value":"no","label":"Croix"},{"value":"text","label":"Texte libre"}]},{"type":"text","id":"v2_text","label":"Texte","default":"—"},{"type":"header","content":"Colonne 4"},{"type":"select","id":"v3","label":"Type","default":"text","options":[{"value":"yes","label":"Coche"},{"value":"no","label":"Croix"},{"value":"text","label":"Texte libre"}]},{"type":"text","id":"v3_text","label":"Texte","default":"—"}]}],"presets":[{"name":"NVD — Vs concurrence","blocks":[{"type":"row","settings":{"label":"Produit neuf et scellé","v1":"yes","v2":"yes","v3":"text","v3_text":"Variable"}},{"type":"row","settings":{"label":"Authenticité garantie","v1":"yes","v2":"yes","v3":"text","v3_text":"Selon vendeur"}},{"type":"row","settings":{"label":"Livraison offerte","v1":"yes","v2":"yes","v3":"text","v3_text":"Selon vendeur"}},{"type":"row","settings":{"label":"Garantie légale 2 ans","v1":"yes","v2":"yes","v3":"text","v3_text":"Souvent absente"}}]}]}
{% endschema %}