{%- comment -%}NOVADESTOCK — Livraison{%- endcomment -%}
{% render 'nvd-css', accent: section.settings.accent_color, ink: section.settings.text_color %}
<style>
#shopify-section-{{ section.id }} .sh{background:{{ section.settings.background_color }};padding:{{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px}
#shopify-section-{{ section.id }} .sh__g{display:grid;grid-template-columns:.9fr 1.1fr;gap:56px;align-items:center}
#shopify-section-{{ section.id }} .sh__lead{font-size:16px;line-height:1.62;margin:0 0 22px;color:var(--muted)}
#shopify-section-{{ section.id }} .sh__pill{display:inline-flex;align-items:center;gap:9px;padding:12px 20px;border-radius:100px;font-weight:700;font-size:14px;background:var(--soft);color:var(--a);border:1px solid color-mix(in srgb,var(--a) 24%,transparent)}
#shopify-section-{{ section.id }} .tl__i{display:grid;grid-template-columns:44px 1fr;gap:18px;position:relative;padding-bottom:30px}
#shopify-section-{{ section.id }} .tl__i:last-child{padding-bottom:0}
#shopify-section-{{ section.id }} .tl__i:not(:last-child):before{content:"";position:absolute;left:21px;top:46px;bottom:4px;width:2px;background:color-mix(in srgb,var(--a) 22%,transparent)}
#shopify-section-{{ section.id }} .tl__ic{width:44px;height:44px;border-radius:14px;display:grid;place-items:center;z-index:1;background:#fff;color:var(--a);border:1.5px solid color-mix(in srgb,var(--a) 26%,transparent)}
#shopify-section-{{ section.id }} .tl__t{font-weight:700;font-size:15.5px;margin:0 0 4px;color:var(--ink);letter-spacing:-.015em}
#shopify-section-{{ section.id }} .tl__d{font-size:14px;line-height:1.58;margin:0;color:var(--muted)}
#shopify-section-{{ section.id }} .tl__w{display:inline-block;font-size:11.5px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:var(--a);margin-top:6px}
@media(max-width:880px){#shopify-section-{{ section.id }} .sh__g{grid-template-columns:1fr;gap:36px}}
</style>
<div class="nvd sh"><div class="nvd__in--n sh__g">
<div><h2 class="nvd__h">{{ section.settings.heading }}</h2><p class="sh__lead">{{ section.settings.subheading }}</p>{%- if section.settings.pill != blank -%}<span class="sh__pill"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M1 3h13v13H1zM14 8h4l3 3v5h-7z"/><circle cx="5.5" cy="19" r="2"/><circle cx="17.5" cy="19" r="2"/></svg>{{ section.settings.pill }}</span>{%- endif -%}</div>
<div>{%- for block in section.blocks -%}<div class="tl__i" {{ block.shopify_attributes }}><div class="tl__ic">
{%- case block.settings.icon -%}
{%- when 'cart' -%}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h2l2.5 11h10L20 7H6"/><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/></svg>
{%- when 'box' -%}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg>
{%- when 'plane' -%}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12l20-8-8 20-2.5-8.5z"/></svg>
{%- when 'home' -%}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-8 9 8v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
{%- else -%}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
{%- endcase -%}
</div><div><p class="tl__t">{{ block.settings.title }}</p><p class="tl__d">{{ block.settings.text }}</p>{%- if block.settings.when != blank -%}<span class="tl__w">{{ block.settings.when }}</span>{%- endif -%}</div></div>{%- endfor -%}</div>
</div></div>
{% schema %}
{"name":"NVD — Livraison","tag":"section","settings":[{"type":"text","id":"heading","label":"Titre","default":"Livré chez vous en 3 à 7 jours"},{"type":"textarea","id":"subheading","label":"Sous-titre","default":"Expédition sous 24 h ouvrées, numéro de suivi fourni."},{"type":"text","id":"pill","label":"Encart","default":"Livraison offerte, sans minimum d'achat"},{"type":"header","content":"Couleurs & espacements"},{"type":"color","id":"accent_color","label":"Accent","default":"#127aa9"},{"type":"color","id":"text_color","label":"Texte","default":"#0A0A0A"},{"type":"color","id":"background_color","label":"Fond","default":"#FFFFFF"},{"type":"range","id":"padding_top","min":0,"max":160,"step":4,"unit":"px","label":"Marge haute","default":76},{"type":"range","id":"padding_bottom","min":0,"max":160,"step":4,"unit":"px","label":"Marge basse","default":76}],"blocks":[{"type":"step","name":"Étape","settings":[{"type":"select","id":"icon","label":"Icône","default":"cart","options":[{"value":"cart","label":"Panier"},{"value":"box","label":"Colis"},{"value":"plane","label":"Transport"},{"value":"home","label":"Domicile"},{"value":"check","label":"Coche"}]},{"type":"text","id":"title","label":"Titre","default":"Étape"},{"type":"textarea","id":"text","label":"Description","default":"Description"},{"type":"text","id":"when","label":"Délai","default":"Jour 1"}]}],"presets":[{"name":"NVD — Livraison","blocks":[{"type":"step","settings":{"icon":"cart","title":"Commande confirmée","text":"Confirmation et facture nominative par e-mail.","when":"Immédiat"}},{"type":"step","settings":{"icon":"box","title":"Préparation et contrôle","text":"Numéro de série vérifié, emballage jamais descellé.","when":"Sous 24 h ouvrées"}},{"type":"step","settings":{"icon":"plane","title":"Expédition et suivi","text":"Numéro de suivi envoyé dès la remise au transporteur.","when":"Jour 1 à 2"}},{"type":"step","settings":{"icon":"home","title":"Livraison à domicile","text":"À domicile ou en point relais, au choix.","when":"Jour 3 à 7"}}]}]}
{% endschema %}