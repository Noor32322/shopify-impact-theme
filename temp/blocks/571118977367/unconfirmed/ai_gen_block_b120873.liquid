{% doc %}
  @prompt
    genere une section defilante avis ou je peux upload manuellement les photo et les corps ecrit d'avis on peut defiler horizontalement 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-carousel-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    padding: 40px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-reviews-carousel__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-reviews-carousel__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 40px;
  }

  .ai-reviews-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 10px;
  }

  .ai-reviews-carousel__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-reviews-carousel__wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-reviews-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_spacing }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 10px 0;
  }

  .ai-reviews-carousel__track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-reviews-carousel__card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-reviews-carousel__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: #f4f4f4;
  }

  .ai-reviews-carousel__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-reviews-carousel__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-reviews-carousel__image-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  .ai-reviews-carousel__rating-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
  }

  .ai-reviews-carousel__star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-reviews-carousel__star--empty-{{ ai_gen_id }} {
    fill: {{ block.settings.star_empty_color }};
  }

  .ai-reviews-carousel__content-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-reviews-carousel__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-reviews-carousel__author-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_text_size }}px;
    color: {{ block.settings.author_color }};
    font-weight: 600;
    margin: 0;
  }

  .ai-reviews-carousel__controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 30px;
  }

  .ai-reviews-carousel__button-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-reviews-carousel__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    transform: scale(1.1);
  }

  .ai-reviews-carousel__button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-reviews-carousel__button-{{ ai_gen_id }}:disabled:hover {
    transform: none;
  }

  .ai-reviews-carousel__button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-reviews-carousel__card-{{ ai_gen_id }} {
      flex: 0 0 280px;
    }

    .ai-reviews-carousel__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }
{% endstyle %}

<reviews-carousel-{{ ai_gen_id }} class="ai-reviews-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-reviews-carousel__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-reviews-carousel__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-reviews-carousel__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-reviews-carousel__subtitle-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-reviews-carousel__wrapper-{{ ai_gen_id }}">
      <div class="ai-reviews-carousel__track-{{ ai_gen_id }}" data-track>
        {% for i in (1..6) %}
          {% liquid
            assign review_image_key = 'review_' | append: i | append: '_image'
            assign review_text_key = 'review_' | append: i | append: '_text'
            assign review_author_key = 'review_' | append: i | append: '_author'
            assign review_rating_key = 'review_' | append: i | append: '_rating'

            assign review_image = block.settings[review_image_key]
            assign review_text = block.settings[review_text_key]
            assign review_author = block.settings[review_author_key]
            assign review_rating = block.settings[review_rating_key]
          %}

          {% if review_text != blank or review_author != blank or review_image != blank %}
            <div class="ai-reviews-carousel__card-{{ ai_gen_id }}">
              <div class="ai-reviews-carousel__image-wrapper-{{ ai_gen_id }}">
                {% if review_image %}
                  <img
                    src="{{ review_image | image_url: width: 600 }}"
                    alt="{{ review_author | escape }}"
                    class="ai-reviews-carousel__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="{{ block.settings.image_height }}"
                  >
                {% else %}
                  <div class="ai-reviews-carousel__image-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-reviews-carousel__rating-{{ ai_gen_id }}">
                {% for star in (1..5) %}
                  <svg
                    class="ai-reviews-carousel__star-{{ ai_gen_id }} {% if star > review_rating %}ai-reviews-carousel__star--empty-{{ ai_gen_id }}{% endif %}"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                {% endfor %}
              </div>

              <div class="ai-reviews-carousel__content-{{ ai_gen_id }}">
                {% if review_text != blank %}
                  <p class="ai-reviews-carousel__text-{{ ai_gen_id }}">{{ review_text }}</p>
                {% endif %}
              </div>

              {% if review_author != blank %}
                <p class="ai-reviews-carousel__author-{{ ai_gen_id }}">{{ review_author }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% if block.settings.show_controls %}
      <div class="ai-reviews-carousel__controls-{{ ai_gen_id }}">
        <button
          class="ai-reviews-carousel__button-{{ ai_gen_id }}"
          data-prev
          aria-label="Avis précédent"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button
          class="ai-reviews-carousel__button-{{ ai_gen_id }}"
          data-next
          aria-label="Avis suivant"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    {% endif %}
  </div>
</reviews-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ReviewsCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('[data-track]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.scrollAmount = {{ block.settings.card_width | plus: block.settings.card_spacing }};
      }

      connectedCallback() {
        if (this.prevButton && this.nextButton) {
          this.prevButton.addEventListener('click', () => this.scroll('prev'));
          this.nextButton.addEventListener('click', () => this.scroll('next'));
          this.track.addEventListener('scroll', () => this.updateButtons());
          this.updateButtons();
        }
      }

      scroll(direction) {
        const scrollLeft = this.track.scrollLeft;
        const newScrollLeft = direction === 'next'
          ? scrollLeft + this.scrollAmount
          : scrollLeft - this.scrollAmount;

        this.track.scrollTo({
          left: newScrollLeft,
          behavior: 'smooth'
        });
      }

      updateButtons() {
        const maxScroll = this.track.scrollWidth - this.track.clientWidth;
        this.prevButton.disabled = this.track.scrollLeft <= 0;
        this.nextButton.disabled = this.track.scrollLeft >= maxScroll - 1;
      }
    }

    customElements.define('reviews-carousel-{{ ai_gen_id }}', ReviewsCarousel{{ ai_gen_id }});
  })();
</script>

