{% doc %}
  @prompt
    genere moi une etion ou juste j'ajoute une video qui se lance en boucle du debut a la fin etc automatiquement quand le client est sur la page 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-block-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.aspect_ratio }}%;
    background-color: #000000;
  }

  .ai-video-element-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-video-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-video-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-video-block-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<video-autoplay-{{ ai_gen_id }}
  class="ai-video-block-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-video-wrapper-{{ ai_gen_id }}">
    {% if block.settings.video != blank %}
      <video
        class="ai-video-element-{{ ai_gen_id }}"
        autoplay
        loop
        muted
        playsinline
        {% if block.settings.show_controls %}controls{% endif %}
      >
        <source src="{{ block.settings.video }}" type="video/mp4">
        Votre navigateur ne supporte pas la lecture de vidéos.
      </video>
    {% else %}
      <div class="ai-video-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-video-empty-state-{{ ai_gen_id }}">
          Ajoutez une vidéo pour commencer
        </div>
      </div>
    {% endif %}
  </div>
</video-autoplay-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoAutoplay{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.video = this.querySelector('.ai-video-element-{{ ai_gen_id }}');
        
        if (this.video) {
          this.ensureAutoplay();
          this.setupIntersectionObserver();
        }
      }

      ensureAutoplay() {
        const playPromise = this.video.play();
        
        if (playPromise !== undefined) {
          playPromise.catch(function() {
            this.video.muted = true;
            this.video.play();
          }.bind(this));
        }
      }

      setupIntersectionObserver() {
        const options = {
          root: null,
          rootMargin: '0px',
          threshold: 0.5
        };

        const observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              this.video.play();
            } else {
              this.video.pause();
            }
          }.bind(this));
        }.bind(this), options);

        observer.observe(this.video);
      }
    }

    customElements.define('video-autoplay-{{ ai_gen_id }}', VideoAutoplay{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Vidéo en boucle",
  "settings": [
    {
      "type": "header",
      "content": "Vidéo"
    },
    {
      "type": "url",
      "id": "video",
      "label": "Fichier vidéo"
    },
    {
      "type": "paragraph",
      "content": "Téléchargez votre vidéo dans les fichiers de votre boutique, puis collez l'URL ici. La vidéo se lancera automatiquement en boucle."
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Afficher les contrôles",
      "default": false
    },
    {
      "type": "header",
      "content": "Dimensions"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Largeur sur ordinateur",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Format d'image",
      "options": [
        {
          "value": "56.25",
          "label": "16:9"
        },
        {
          "value": "75",
          "label": "4:3"
        },
        {
          "value": "100",
          "label": "Carré (1:1)"
        },
        {
          "value": "133.33",
          "label": "3:4"
        },
        {
          "value": "177.78",
          "label": "9:16"
        }
      ],
      "default": "56.25"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Arrondi des coins",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Vidéo en boucle"
    }
  ]
}
{% endschema %}