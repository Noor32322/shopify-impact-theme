        "q2": {
          "type": "q",
          "settings": {
            "question": "Pourquoi ce prix est-il aussi bas ?",
            "answer": "<p>Nous achetons des lots de fin de série auprès de distributeurs européens qui doivent libérer leur stock. Nous les revendons sans structure de boutique physique. C'est le circuit d'approvisionnement qui change, pas le produit.</p>",
            "open": false
          }
        },
