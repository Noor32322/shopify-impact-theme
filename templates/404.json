        "ai_gen_block_b120873_qpREgz": {
          "type": "ai_gen_block_b120873",
          "settings": {
            "heading": "Ce que disent nos clients",
            "subheading": "",
            "heading_alignment": "center",
            "heading_size": 36,
            "subheading_size": 16,
            "review_1_image": "shopify://shop_images/ChatGPT_Image_11_aout_2026_21_56_10.png",
            "review_1_rating": 5,
            "review_1_text": "« Franchement impressionnée ! J’ai retiré énormément de sous-poil dès la première utilisation. Mon chien se laisse brosser tranquillement et j’ai beaucoup moins de poils sur le canapé. »",
            "review_1_author": "Marie D.",
            "review_2_image": "shopify://shop_images/ChatGPT_Image_12_aout_2026_18_09_26.png",
            "review_2_rating": 5,
            "review_2_text": "« Avec deux chiens à la maison, les poils étaient partout. Depuis que j’utilise cette brosse régulièrement, la différence est vraiment visible. Elle retire beaucoup de poils morts sans tirer. »",
            "review_2_author": "Pierre L.",
            "review_3_image": "shopify://shop_images/ChatGPT_Image_12_aout_2026_18_10_45.png",
            "review_3_rating": 5,
            "review_3_text": "« Mon chien n’aime normalement pas être brossé, mais avec celle-ci il reste calme. Elle passe bien dans le pelage et enlève le sous-poil tout en douceur. Très contente de mon achat. »",
            "review_3_author": "Sophie M.",
            "review_4_image": "shopify://shop_images/avis4.jpg",
            "review_4_rating": 5,
            "review_4_text": "« Testée en pleine période de mue sur mon golden et je suis bluffée par la quantité de poils récupérée. Après quelques passages seulement, son pelage est beaucoup plus propre et doux. »",
            "review_4_author": "Thomas B.",
            "review_5_image": "shopify://shop_images/ChatGPT_Image_12_aout_2026_18_13_00.png",
            "review_5_rating": 5,
            "review_5_text": "« La prise en main est agréable et la brosse fait vraiment bien son travail. Elle enlève les poils morts rapidement sans avoir besoin de forcer. Je recommande. »",
            "review_5_author": "Julie R.",
            "review_6_image": "shopify://shop_images/ChatGPT_Image_12_aout_2026_18_16_15.png",
            "review_6_rating": 5,
            "review_6_text": "« J’avais peur que les dents tirent sur les poils, mais pas du tout. Mon chat se laisse faire et j’arrive enfin à retirer correctement le sous-poil. Son pelage est beaucoup plus beau après le brossage. »",
            "review_6_author": "Alexandre C.",
